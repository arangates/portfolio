{
  "mcpServers": {
    "better-t-stack": {
      "command": "pnpm",
      "args": ["dlx", "create-better-t-stack@latest", "mcp"]
    },
    "neon": {
      "type": "http",
      "url": "https://mcp.neon.tech/mcp"
    },
    "context7": {
      "type": "local",
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"],
      "tools": ["*"]
    },
    "next-devtools": {
      "type": "local",
      "command": "npx",
      "args": ["-y", "next-devtools-mcp@latest"],
      "tools": ["*"]
    },
    "shadcn": {
      "type": "local",
      "command": "npx",
      "args": ["-y", "shadcn@latest", "mcp"],
      "tools": ["*"]
    }
  }
}
