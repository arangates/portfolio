  "cards": [
    {
      "dot": "rose",
      "title": "Trust and ownership",
      "items": [
        "Route handlers derive userId from the Better Auth server session; clients never choose an owner.",
        "Financial rows carry user_id, and composite foreign keys keep child history with the same owner."
      ]
    },
    {
      "dot": "cyan",
      "title": "Historical ingestion",
      "items": [
        "SHA-256 file and row hashes make repeated broker uploads idempotent.",
        "Raw imports, normalized ledger entries, and dated snapshots preserve provenance instead of overwriting history."
      ]
    },
    {
      "dot": "emerald",
      "title": "Calculation and presentation",
      "items": [
        "Server-only services aggregate account-scoped Postgres data and disclose missing FX conversions.",
        "Pure FIRE and analytics logic produces derived series; the browser renders tables and ECharts visualizations."
      ]
    },
    {
      "dot": "violet",
      "title": "Operational boundary",
      "items": [
        "The Vercel runtime receives only the pooled DATABASE_URL and application secrets.",
        "Direct database credentials stay outside the deployed application and are reserved for trusted migrations."
      ]
    }
  ]
