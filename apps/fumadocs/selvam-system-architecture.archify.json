  "cards": [
    {
      "dot": "rose",
      "title": "Trust and sovereign identity",
      "items": [
        "Sovereign mode derives session and hardware encryption from AES-256-GCM + PBKDF2 local keys.",
        "Financial rows carry user_id, and foreign keys strictly isolate history to the local identity."
      ]
    },
    {
      "dot": "cyan",
      "title": "Clean architecture engine",
      "items": [
        "@portfolio/calc provides zero-dependency pure calculations (FIRE, XIRR, Net Worth, FX conversions).",
        "@portfolio/parsers normalizes multi-broker exports and payslips into clean typed ledger events."
      ]
    },
    {
      "dot": "emerald",
      "title": "Embedded on-device data engine",
      "items": [
        "Embedded WASM PGlite executes PostgreSQL directly on device, storing data in ./data/selvam.db.",
        "Local document vault stores original statements under ./data/vault/documents/ with SHA-256 hashes."
      ]
    },
    {
      "dot": "violet",
      "title": "Native multi-platform shell",
      "items": [
        "Tauri 2.0 Rust shell wraps the app into native desktop and mobile installers (DMG, EXE, AppImage).",
        "Air-gapped operation ensures financial analytics and pulse stories run completely offline."
      ]
    }
  ]
