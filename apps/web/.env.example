# Pooled connection used by the deployed application.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require

# Direct connection used only for Drizzle migrations.
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DATABASE?sslmode=require

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# Use http://localhost:3001 locally and the exact HTTPS origin in Vercel.
BETTER_AUTH_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3001
