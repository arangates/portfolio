{
  "name": "selvam",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev -F web",
    "db:push": "turbo run db:push -F @portfolio/db",
    "db:studio": "turbo run db:studio -F @portfolio/db",
    "db:generate": "turbo run db:generate -F @portfolio/db",
    "db:migrate": "turbo run db:migrate -F @portfolio/db",
    "db:reset-data": "pnpm --filter @portfolio/db db:reset-data",
    "db:import-legacy-workbook": "pnpm --filter @portfolio/db db:import-legacy-workbook",
    "db:import-fire-workbook": "pnpm --filter @portfolio/db db:import-fire-workbook",
    "db:import-household-workbook": "pnpm --filter @portfolio/db db:import-household-workbook",
    "check": "oxlint && oxfmt --write",
    "prepare": "husky"
  },
  "dependencies": {
    "@portfolio/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@portfolio/config": "workspace:*",
    "@types/node": "^22.20.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "turbo": "^2.10.7",
    "typescript": "catalog:"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,jsx,ts,tsx}": [
      "oxlint --",
      "oxfmt --write"
    ]
  },
  "packageManager": "pnpm@11.17.0"
}
