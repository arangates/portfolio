# For the Vercel/Docker shared database setup, set this to the Neon pooled URL.
DATABASE_URL=
# Optional direct Neon URL used for startup migrations.
DATABASE_URL_DIRECT=

# Change this before exposing the app to a network.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3001
APP_PORT=3001
DOCS_PORT=4000
# Drizzle Studio is bound to 127.0.0.1 on the Docker host.
DRIZZLE_STUDIO_PORT=4983

# Only needed for the self-contained Docker/Postgres mode:
POSTGRES_USER=selvam
POSTGRES_PASSWORD=replace-with-a-url-safe-random-password
POSTGRES_DB=selvam

# Optional integrations
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# TWELVE_DATA_API_KEY=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=
# CRON_SECRET=
# NEXT_PUBLIC_ENABLE_LABS=true
